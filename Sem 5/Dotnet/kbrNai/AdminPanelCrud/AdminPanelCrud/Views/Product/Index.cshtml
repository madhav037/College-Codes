@* @model List<Product> *@
@model DataTable
@using System.Data

<div class="card-body d-flex justify-content-between align-items-center w-100">
    <h5 class="card-title fs-2 fw-bold">Product</h5>

    <div class="">
        <a asp-controller="Product" asp-action="ProductAddEdit" class="btn btn-success">ADD</a>
    </div>
</div>


<div class="datatable-container mt-4">
    <table class="table datatable datatable-table">

        <thead>
        @* <th>Product ID</th> *@
        <th>Product Name</th>
        <th>Product Price</th>
        <th>Product Code</th>
        <th>Description</th>
        <th>User name</th>
        <th colspan="2"> Actions</th>
        </thead>
        <tbody>
            <h4 class="text-danger">@TempData["ErrorMessage"]</h4>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    @* <td>@row["ProductID"]</td> *@
                    <td>@row["ProductName"]</td>
                    <td>@row["ProductPrice"]</td>
                    <td>@row["ProductCode"]</td>
                    <td>@row["Description"]</td>
                    <td>@row["UserName"]</td>
                    <td>
                        <a class="btn btn-outline-success btn-xs" asp-controller="Product" asp-action="ProductAddEdit" asp-route-ProductID="@row["ProductID"]">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                    </td>
                    @*td><a class="btn btn-danger">DELETE</a></td> *@
                    <td>
                        <form method="post" asp-controller="Product" asp-action="ProductDelete">
                            <input type="hidden" name="ProductID" value="@row["ProductID"]" />
                            <button type="submit" class="btn btn-outline-danger btn-xs">
                                <i class="bi bi-x"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
