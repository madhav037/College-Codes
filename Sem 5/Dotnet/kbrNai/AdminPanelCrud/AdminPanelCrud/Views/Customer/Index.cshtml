@model DataTable
@using System.Data
<div class="card-body d-flex justify-content-between align-items-center w-100">
    <h5 class="card-title fs-2 fw-bold">Customer</h5>

    <div class="">
        <a asp-controller="Customer" asp-action="CustomerAddEdit" class="btn btn-success">ADD</a>
    </div>
</div>
<div class="datatable-container mt-4">
    <table class="table datatable datatable-table">

        <thead>
        @* <th>CustomerID</th> *@
        <th>Customer Name</th>
        <th>Home Address</th>
        <th>Email</th>
        <th>MobileNo</th>
        <th>GST NO </th>
        <th>City Name</th>
        <th>PinCode</th>
        <th>Net Amount</th>
        <th>User Name</th>
        <th colspan="2"> Actions</th>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    @* <td>@row["CustomerID"]</td> *@
                    <td>@row["CustomerName"]</td>
                    <td>@row["HomeAddress"]</td>
                    <td>@row["Email"]</td>
                    <td>@row["MobileNo"]</td>
                    <td>@row["GSTNO"]</td>
                    <td>@row["CityName"]</td>
                    <td>@row["PinCode"]</td>
                    <td>@row["NetAmount"]</td>
                    <td>@row["UserName"]</td>
                    <td><a class="btn btn-primary" asp-controller="Customer" asp-action="CustomerAddEdit" asp-route-CustomerID="@row["CustomerID"]"><i class="bi bi-pencil-fill"></a></td>
                    <td>
                        <form method="post" asp-controller="Customer" asp-action="CustomerDelete">
                            <input type="hidden" name="CustomerID" value="@row["CustomerID"]" />
                            <button type="submit" class="btn btn-outline-danger btn-xs">
                                <i class="bi bi-x"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
    </div>
<!-- End Table with stripped rows -->
</div>

